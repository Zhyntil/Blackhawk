
# ==========================================
# Blackhawk Trading Company
# Baseline .gitignore
# ==========================================

# Secrets and environment settings
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.p8
*.jks
id_rsa
id_ed25519
*.pub

# Local configuration
config.local.*
*.local.json
appsettings.*.local.json

# Logs and diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
tmp/
temp/
cache/
*.tmp
*.bak
*.old
*.orig
*.swp
*~
/Claude outputs/

# Database exports and backups
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.bak.zip
*.7z

# OS artifacts
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE files
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.user
*.userosscache

# Node dependencies
node_modules/
.npm/
.pnpm-store/

# Test coverage
coverage/
.nyc_output/

# Python environments and caches
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/

# Local development tools
.vagrant/
.terraform/
*.tfstate
*.tfstate.*