

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Blackhawk rebuild: load the new PHP landing page first, and send old /index.html links to the home page
DirectoryIndex index.php index.html
RedirectMatch 301 ^/index\.html$ /

# Overstock Sale page retired 2026-09 — send old links and bookmarks to Specials / Sale
RedirectMatch 301 ^/overstock-sale\.html$ /specialssale.html
